# Base de données (voir docker-compose.yml pour les valeurs par défaut en local). En production
# avec Neon, utiliser la chaîne de connexion DIRECTE (pas celle avec "-pooler" dans l'hôte) : ce
# service tourne en process long (pas en edge/serverless), le pooling PgBouncer de Neon n'apporte
# rien ici et complique inutilement `prisma migrate deploy`. Voir DEPLOYMENT.md.
DATABASE_URL="postgresql://mouslih:mouslih@127.0.0.1:5434/mouslih_academy?schema=public"

# Serveur
PORT=3001
# Origine(s) autorisée(s) en CORS pour le frontend Next.js — liste séparée par des virgules
# (ex. domaine de prod Vercel + éventuelles URLs de preview).
CORS_ORIGIN="http://localhost:3000"
# URL publique de cette API, utilisée pour construire les URLs absolues des fichiers uploadés
# localement (couvertures de formation, voir uploads/) — à remplacer par le vrai domaine en
# production, ou par l'URL du bucket une fois le stockage objet (Cloudflare R2) branché.
PUBLIC_URL="http://127.0.0.1:3001"
# Dossier racine des fichiers uploadés (couvertures de formation). Sur un hébergeur au système de
# fichiers éphémère (Render notamment), pointer vers un disque persistant monté (ex.
# "/var/data/uploads") — sinon les couvertures uploadées disparaissent au redéploiement suivant.
# Par défaut : ./uploads à la racine du projet (identique au comportement précédent).
UPLOADS_DIR=""

# JWT
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="30d"

# Cloudflare Stream (leçons payantes) + R2 (ressources de leçon) — voir src/media.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
# Code de sous-domaine de lecture Stream (onglet Stream du dashboard Cloudflare) — distinct de
# CLOUDFLARE_ACCOUNT_ID, sert à construire customer-<code>.cloudflarestream.com.
CLOUDFLARE_STREAM_CUSTOMER_CODE=""
# Clé de signature Stream (distincte du jeton API ci-dessus) : à créer via
# POST /accounts/{id}/stream/keys, nécessaire pour générer des URLs de lecture signées
# (leçons payantes, pas d'accès direct à la vidéo sans avoir vérifié l'inscription).
CLOUDFLARE_STREAM_SIGNING_KEY_ID=""
CLOUDFLARE_STREAM_SIGNING_KEY=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_ENDPOINT=""
# Domaine public du bucket R2, si activé (dashboard R2 → bucket → Settings → Public access) ;
# laissé vide, getUploadUrl() renvoie la clé de l'objet plutôt qu'une URL publique complète.
CLOUDFLARE_R2_PUBLIC_URL=""

# Wave (paiement) — à renseigner une fois les identifiants marchand obtenus ;
# en leur absence, WavePaymentProvider utilise un stub (voir src/orders/payments).
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""
# URL publique du frontend, pour construire les success_url/error_url envoyées à Wave et le lien
# d'accès dans l'e-mail de confirmation de paiement (voir src/email).
FRONTEND_URL="http://localhost:3000"

# SMTP — e-mail envoyé après confirmation d'un paiement (voir src/email). N'importe quel
# fournisseur SMTP convient (Gmail, Zoho, celui de l'hébergeur, SendGrid en mode relais SMTP...) ;
# en leur absence, EmailService se contente de logger au lieu d'envoyer.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Mouslih Academy <no-reply@mouslihacademy.sn>"
