# Base de données (voir docker-compose.yml pour les valeurs par défaut en local)
DATABASE_URL="postgresql://mouslih:mouslih@127.0.0.1:5434/mouslih_academy?schema=public"

# Serveur
PORT=3001
# Origine(s) autorisée(s) en CORS pour le frontend Next.js — liste séparée par des virgules.
CORS_ORIGIN="http://localhost:3000"
# URL publique de cette API, utilisée pour construire les URLs absolues des fichiers uploadés
# localement (couvertures de formation, voir uploads/) — à remplacer par le vrai domaine en
# production, ou par l'URL du bucket une fois le stockage objet (Cloudflare R2) branché.
PUBLIC_URL="http://127.0.0.1:3001"

# JWT
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="30d"

# Cloudflare Stream (leçons payantes) + R2 (ressources de leçon)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_ENDPOINT=""

# Wave (paiement) — à renseigner une fois les identifiants marchand obtenus ;
# en leur absence, WavePaymentProvider utilise un stub (voir src/payments).
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""
